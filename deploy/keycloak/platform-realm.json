{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "k3s-user", "description": "May request and manage own k3s clusters" },
      { "name": "k3s-admin", "description": "May see and manage all k3s clusters" }
    ]
  },
  "clients": [
    {
      "clientId": "k3s-proxmox",
      "name": "k3s on Proxmox",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "http://localhost:5014/*", "https://localhost:7096/*", "http://localhost:8081/*", "${APP_PUBLIC_URL}/*" ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5014/*##https://localhost:7096/*##http://localhost:8081/*##${APP_PUBLIC_URL}/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@example.com",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [ { "type": "password", "value": "dev", "temporary": false } ],
      "realmRoles": [ "k3s-user", "k3s-admin" ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@example.com",
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "User",
      "credentials": [ { "type": "password", "value": "user", "temporary": false } ],
      "realmRoles": [ "k3s-user" ]
    }
  ]
}
