{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=k3sproxmox;Username=k3sproxmox;Password=change-me"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "Keycloak": {
    "Authority": "https://keycloak.example.com/realms/platform",
    "ClientId": "k3s-proxmox",
    "ClientSecret": "",
    "RequireHttpsMetadata": true,
    "AdminRole": "k3s-admin",
    "UserRole": "k3s-user"
  },

  "Proxmox": {
    "BaseUrl": "https://pve1.example.com:8006",
    "TokenId": "k3s-provisioner@pve!app",
    "TokenSecret": "",
    "IgnoreTlsErrors": false,
    "TemplateVmId": 9000,
    "TemplateNode": "pve1",
    "TargetNodes": [ "pve1", "pve2", "pve3" ],
    "Storage": "ceph-vm",
    "DiskDevice": "scsi0",
    "Bridge": "vmbr0",
    "VlanTag": null,
    "Pool": "k3s",
    "VmIdRangeStart": 5000,
    "VmIdRangeEnd": 5999,
    "CiUser": "ubuntu",
    "TaskTimeoutSeconds": 900
  },

  "Network": {
    "PrefixLength": 24,
    "Gateway": "10.20.0.1",
    "DnsServers": [ "10.20.0.53" ],
    "SearchDomain": "example.com",
    "NodeRangeStart": "10.20.0.100",
    "NodeRangeEnd": "10.20.0.199",
    "VipRangeStart": "10.20.0.200",
    "VipRangeEnd": "10.20.0.249"
  },

  "Dns": {
    "Provider": "None",
    "BaseDomain": "k8s.example.com",
    "Zone": "example.com",
    "Ttl": 300,
    "PowerDns": {
      "ApiUrl": "http://pdns.example.com:8081",
      "ApiKey": "",
      "ServerId": "localhost"
    },
    "Cloudflare": {
      "ApiToken": "",
      "ZoneId": ""
    }
  },

  "Clusters": {
    "K3sVersions": [ "v1.34.1+k3s1", "v1.33.5+k3s1", "v1.32.9+k3s1" ],
    "CiliumVersion": "1.18.3",
    "ArgoCdChartVersion": "9.1.0",
    "HelmInstallScriptUrl": "https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3",
    "MaxNodesPerCluster": 20,
    "MaxCpuPerNode": 16,
    "MaxMemoryGbPerNode": 64,
    "MinDiskGb": 20,
    "MaxDiskGb": 500,
    "MaxClustersPerUser": 5,
    "MaxConcurrentOperations": 3,

    "StandardApps": [
      {
        "Key": "cert-manager",
        "DisplayName": "cert-manager",
        "Description": "TLS certificate automation.",
        "Required": true,
        "RepoUrl": "https://charts.jetstack.io",
        "Chart": "cert-manager",
        "TargetRevision": "v1.19.1",
        "Namespace": "cert-manager",
        "SyncWave": -10,
        "HelmValues": "crds:\n  enabled: true\n"
      },
      {
        "Key": "cloudnative-pg",
        "DisplayName": "PostgreSQL operator (CloudNativePG)",
        "Description": "Cloud native PostgreSQL operator for in-cluster databases.",
        "DefaultEnabled": true,
        "RepoUrl": "https://cloudnative-pg.github.io/charts",
        "Chart": "cloudnative-pg",
        "TargetRevision": "0.26.1",
        "Namespace": "cnpg-system",
        "SyncWave": -5
      },
      {
        "Key": "monitoring",
        "DisplayName": "Monitoring (Prometheus + Grafana)",
        "Description": "kube-prometheus-stack; Grafana at grafana.<cluster domain>.",
        "DefaultEnabled": true,
        "RepoUrl": "https://prometheus-community.github.io/helm-charts",
        "Chart": "kube-prometheus-stack",
        "TargetRevision": "79.5.0",
        "Namespace": "monitoring",
        "SyncWave": 0,
        "HelmValues": "grafana:\n  ingress:\n    enabled: true\n    ingressClassName: cilium\n    hosts:\n      - grafana.{{clusterFqdn}}\n"
      },
      {
        "Key": "launch-control",
        "DisplayName": "Launch Control",
        "Description": "Our standard Launch Control deployment.",
        "DefaultEnabled": true,
        "RepoUrl": "https://git.example.com/platform/launch-control-deploy.git",
        "Path": "deploy/k3s",
        "TargetRevision": "main",
        "Namespace": "launch-control",
        "SyncWave": 5
      }
    ]
  }
}
