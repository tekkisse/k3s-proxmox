<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - k3s on Proxmox</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Clusters" asp-action="Index">k3s on Proxmox</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Clusters" asp-action="Index">Clusters</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Clusters" asp-action="Create">New cluster</a></li>
            </ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3">@User.Identity.Name</span>
                <form method="post" action="/account/logout" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                </form>
            }
        </div>
    </nav>
</header>
<main class="container pb-5">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @RenderBody()
</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
