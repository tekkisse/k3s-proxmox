@model List<Cluster>
@{
    ViewData["Title"] = "Clusters";
    var isAdmin = ViewBag.IsAdmin == true;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kubernetes clusters</h1>
    <a class="btn btn-primary" asp-action="Create">Request a cluster</a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded">
        <p class="mb-2">You have no clusters yet.</p>
        <a asp-action="Create">Request your first cluster</a>
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Nodes</th>
            <th>Size per node</th>
            <th>Version</th>
            @if (isAdmin) { <th>Owner</th> }
            <th>Created</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a><div class="small text-muted">@c.Fqdn</div></td>
                <td><partial name="_StatusBadge" model="@c.Status.ToString()" /></td>
                <td>@c.ControlPlaneCount server + @c.WorkerCount worker</td>
                <td>@c.NodeCpu vCPU / @(c.NodeMemoryMb / 1024) GB / @c.NodeDiskGb GB</td>
                <td>@c.K3sVersion</td>
                @if (isAdmin) { <td>@c.OwnerName</td> }
                <td>@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}
