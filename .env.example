# Copy to .env and fill in. Used by docker-compose.yml for the "app" service.
# Leave values empty to browse the UI without real infrastructure (provisioning will then fail).

# --- Proxmox ---
PROXMOX_BASE_URL=https://pve1.example.com:8006
PROXMOX_TOKEN_ID=k3s-provisioner@pve!app
PROXMOX_TOKEN_SECRET=
PROXMOX_IGNORE_TLS_ERRORS=false
PROXMOX_TEMPLATE_VMID=9000
PROXMOX_TEMPLATE_NODE=pve1
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0

# --- Node network (static IPs via cloud-init) ---
NETWORK_GATEWAY=10.20.0.1
NETWORK_PREFIX_LENGTH=24
NETWORK_NODE_RANGE_START=10.20.0.100
NETWORK_NODE_RANGE_END=10.20.0.199
NETWORK_VIP_RANGE_START=10.20.0.200
NETWORK_VIP_RANGE_END=10.20.0.249

# --- Self-hosted DNS (PowerDNS, authoritative for the delegated sub-domain) ---
# Clusters get <name>.<DNS_ZONE>, e.g. api.team-dev.tetredns.chi.swan.ac.uk and *.team-dev.tetredns.chi.swan.ac.uk
DNS_ZONE=tetredns.chi.swan.ac.uk
# IP of the Docker host that AD will send queries to. Becomes ns1.<DNS_ZONE> (use the same IP as glue in AD).
PDNS_NS_IP=
PDNS_NS_NAME=ns1
# Change this from the default for any shared/production deployment.
PDNS_API_KEY=change-me-to-a-long-random-string
# Host address/port to publish DNS on. Bind to the host's LAN IP if something else already uses port 53
# (e.g. systemd-resolved on 127.0.0.53); use another port only for local testing.
PDNS_BIND_IP=0.0.0.0
PDNS_DNS_PORT=53
# Optional: AD DNS servers holding a secondary copy of the zone (comma separated IPs).
# They are allowed to transfer the zone and are NOTIFYed when it changes.
PDNS_ALLOW_AXFR_IPS=127.0.0.0/8
PDNS_ALSO_NOTIFY=
